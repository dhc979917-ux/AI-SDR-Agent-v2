# Used by docker-compose.cloudflare.yml. Copy to cloudflare/.env and fill values.
SDR_DEMO_ADMIN_USER=admin
SDR_DEMO_ADMIN_NAME=Demo Admin
SDR_DEMO_ADMIN_PASSWORD=replace-with-at-least-12-chars
SDR_SEED_DEMO=true
QCC_CACHE_DAYS=0
# 0 = 每次分析都调用企查查 MCP；公开 Demo 会增加额度消耗。
# 设为 30 可启用缓存。
SDR_ENTITY_PROVIDER=auto
QCC_MCP_URL=https://agent.qcc.com/mcp/company/stream
QCC_MCP_TOKEN=
SDR_LLM_API_KEY=
SDR_ASR_API_KEY=
CLOUDFLARE_TUNNEL_TOKEN=
